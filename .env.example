# Copy to .env and fill in. Either key works; DeepSeek is tried first.
#
# With no key at all the board still runs, on a keyword-matching fallback brain
# — enough to see the whole pipeline work, not enough to reason well.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=

# Optional overrides. Leave these COMMENTED OUT rather than blank — a variable
# set to an empty string is not the same as one that is unset, and the provider
# defaults below only apply when they are absent.
#
#   DeepSeek → deepseek-chat  at https://api.deepseek.com/v1
#   OpenAI   → gpt-4o         at https://api.openai.com/v1
#
# SMARTBOARD_MODEL=deepseek-reasoner
# SMARTBOARD_BASE_URL=https://api.openai.com/v1

# Change this before anything leaves your laptop.
JWT_SECRET=nusatel-change-this-in-production
